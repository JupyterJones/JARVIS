{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jarvis",
  "version": "1.0.0",
  "identifier": "com.stark.jarvis",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "STARK INDUSTRIES // J.A.R.V.I.S. (ESPERANZA EDITION)",
        "width": 1280,
        "height": 840,
        "minWidth": 980,
        "minHeight": 660,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
